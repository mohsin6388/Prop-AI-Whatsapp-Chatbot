# ------------------------------------------------------------------
# Copy this file to .env and fill in the values. Never commit .env.
# ------------------------------------------------------------------

NODE_ENV=production
PORT=5000
CLIENT_URL=https://your-frontend-domain.com
APP_BASE_URL=https://your-frontend-domain.com
MONGO_URI=mongodb+srv://user:pass@cluster.mongodb.net/real_estate_crm

# Long random strings (e.g. `openssl rand -hex 32`). Required for production.
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
ENCRYPTION_KEY=
COOKIE_SECURE=true

# ---------------- Meta WhatsApp Cloud API ----------------
META_WHATSAPP_ACCESS_TOKEN=            # permanent System User token
META_WHATSAPP_PHONE_NUMBER_ID=         # the Phone number ID, not the number
META_WHATSAPP_BUSINESS_ACCOUNT_ID=     # WABA ID
META_WHATSAPP_VERIFY_TOKEN=            # any string; same one in Meta dashboard
META_WHATSAPP_APP_SECRET=              # App Dashboard -> Settings -> Basic. Strongly recommended
# META_WHATSAPP_API_VERSION=v26.0      # set to the current Graph API version shown in your Meta app
META_WHATSAPP_OPENING_TEMPLATE_NAME=   # approved template for the first message
META_WHATSAPP_OPENING_TEMPLATE_LANGUAGE=en_US
META_WHATSAPP_DEFAULT_COUNTRY_CODE=91
# META_WHATSAPP_AUTO_SUBSCRIBE=true
# META_WHATSAPP_FORWARD_SECRET=        # only if n8n forwards webhooks to /api/whatsapp/webhook/forward

# Owner of leads who message the number first (a User _id)
DEFAULT_LEAD_OWNER_ID=

# ---------------- Gemini (AI) ----------------
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# GEMINI_MAX_OUTPUT_TOKENS=1024
# GEMINI_THINKING_BUDGET=0             # 0 = fastest; thinking tokens would eat the reply budget
# GEMINI_TIMEOUT_MS=20000
# GEMINI_MAX_RETRIES=2

# ---------------- Conversation behaviour ----------------
# AI_REPLY_DEBOUNCE_MS=3000            # wait for the customer to finish typing a burst
# AI_HISTORY_LIMIT=20                  # messages of context per reply
# AI_FALLBACK_REPLY=Thanks for your message! 🙏 Our team will get back to you shortly.   (or "off")
# AI_ANALYSIS_MIN_INTERVAL_MS=120000   # lead scoring at most every 2 min per chat
# AI_STORE_PROMPTS=false               # true = save the full system prompt on every AI message (debug only)

# "Monica as your assistant" offer at the end of a chat
REFERRAL_ENABLED=true
REFERRAL_PERSON_NAME=Monica
REFERRAL_CONTACT_NUMBER=8750200899

# ---------------- Google Calendar (site visits) ----------------
GOOGLE_CLIENT_EMAIL=
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
GOOGLE_CALENDAR_ID=primary
GOOGLE_CALENDAR_TIMEZONE=Asia/Kolkata
GOOGLE_CALENDAR_EVENT_DURATION_MIN=45

# Daily WhatsApp lead report (time is set in Settings)
# DAILY_REPORT_TIMEZONE=Asia/Kolkata

# ---------------- Email (password reset etc.) ----------------
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Monica CRM <no-reply@yourdomain.com>"

# BULK_SEND_INTERVAL_MS=1000
# RATE_LIMIT_WINDOW_MIN=15
# RATE_LIMIT_MAX=300
# AUTH_RATE_LIMIT_MAX=20
